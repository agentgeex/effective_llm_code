# 环境变量模板（全占位符）。复制为 .env 并把值填成自己的；.env 已被 .gitignore 忽略。
# 本文件不含任何真实凭据，只有变量名与用途。
#
# 说明：本仓库代码直接读进程环境变量（os.environ / config/cfg.py），
# 不会自动加载 .env 文件。要加载可以：
#   set -a; source .env; set +a
# 或使用工具（direnv / dotenv run 等）。

# ---------- 配置文件定位 ----------
# 指定配置文件路径；不设则依次找 <repo>/config/config.json、<repo>/config/config.example.json
AI_STUDY_CONFIG=
# 仓库根目录（不设时自动回落到 cfg.py 所在仓库根）
APP_ROOT_DIR=
# 数据库档案名，对应 config.json 中 db.mysql / db.redis 下的键，默认 db
POOLGUARDER_DB=db

# ---------- 数据库 / 缓存 ----------
MYSQL_PASSWORD=
REDIS_PASSWORD=

# ---------- 大模型 API ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ARK_API_KEY=
MODELSCOPE_API_KEY=

# ---------- 数据标注 ----------
ARGILLA_URL=
ARGILLA_API_KEY=
ARGILLA_USER_PASSWORD=

# ---------- 语音合成 ----------
BAIDU_TTS_API_KEY=
BAIDU_TTS_SECRET_KEY=
XFYUN_APPID=
XFYUN_API_SECRET=
XFYUN_API_KEY=
